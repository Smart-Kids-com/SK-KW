# ========= Shopify (Server) =========
# يُستخدم داخل الخادم (lib/shopify.js)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=your-storefront-access-token
SHOPIFY_API_VERSION=2024-07

# ========= Shopify (Client - اختياري) =========
# احتفاظًا بالتوافق لو في كومبوننت تقرأ المفاتيح كـ NEXT_PUBLIC_*
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# ========= السياسات =========
# 0 = محلي فقط، غير ذلك (أو فارغ) = جرّب Shopify ثم فول-باك محلي
USE_SHOPIFY_POLICIES=

# ========= إعدادات الموقع =========
NEXT_PUBLIC_SITE_URL=https://smartkidskw.com
NEXT_PUBLIC_CURRENCY=KWD
NEXT_PUBLIC_LOCALE=ar-KW
# لبعض الشيفرات القديمة:
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ========= واتساب =========
NEXT_PUBLIC_WHATSAPP_NUMBER=96566635393

# ========= Analytics =========
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=123456789
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# ========= Webhooks / نشر =========
WEBHOOK_SECRET=sk-webhook-secret-2025-smartkids-kw-secure-key
VERCEL_TOKEN=your-vercel-token-if-needed
DEPLOYMENT_HOOK_URL=your-deployment-hook-url

# ========= Next.js =========
NEXT_TELEMETRY_DISABLED=1

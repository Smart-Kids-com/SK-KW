# === Shopify (مطلوب) ===
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=your_storefront_token_here
SHOPIFY_API_VERSION=2024-07

# === عام (اختياري) ===
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_WHATSAPP_NUMBER=+96500000000

# === Admin security (server-only; never put real values in this template) ===
# Existing passwords and OTP secret stay unchanged during this local phase.
ADMIN_PASSWORD_1=
ADMIN_PASSWORD_2=
ADMIN_OTP_SECRET=
# Random secret of at least 32 characters, identical on all application instances.
AUTH_SESSION_SECRET=
# Dedicated shared authentication database; NEVER use the store DATABASE_URL.
# Apply db/auth-schema.sql explicitly to that separate DB before enabling admin.
AUTH_DATABASE_URL=
AUTH_DATABASE_AUTH_TOKEN=
# Canonical storefront origin, e.g. https://smartkidskw.com
PUBLIC_ORIGIN=
STORE_MAINTENANCE=0
# Keep sales paused until inventory is reviewed and reopening is explicitly approved.
STORE_SALES_PAUSED=1
